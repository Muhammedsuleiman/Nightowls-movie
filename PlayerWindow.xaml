<Window x:Class="NightOwls.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="{Binding TitleText}" Width="1280" Height="760" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF000000" FontFamily="{StaticResource FontMain}"
        WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <vlc:VideoView x:Name="Video">
        <Grid x:Name="OverlayRoot" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Keeps the floating overlay window hit-testable while chrome is collapsed;
                 without it LibVLCSharp's pass-through window lets mouse moves fall through
                 to the native video, so controls could never reappear.
                 Alpha 0x01 is imperceptible but enables hit testing. -->
            <Rectangle x:Name="RevealCatcher" Fill="#01FFFFFF" Grid.RowSpan="3"/>

            <Border x:Name="TopBar" Grid.Row="0" Padding="20,14,16,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B2000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostIconButton}" Click="Minimize_Click">
                            <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE921;" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource GhostIconButton}" Click="Maximize_Click">
                            <TextBlock x:Name="maxGlyph" FontFamily="{StaticResource FontIcons}" Text="&#xE922;" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource GhostIconButton}" Click="Close_Click">
                            <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE8BB;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FFF2EFE9" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="BottomBar" Grid.Row="2" Padding="18,6,18,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#C8000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <DockPanel Margin="0,4,0,4" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" Foreground="#FFF2EFE9"
                                   FontSize="11.5" VerticalAlignment="Center" MinWidth="52"/>
                        <Slider x:Name="SeekSlider" Style="{StaticResource PlayerSlider}"
                                Minimum="0" Maximum="{Binding SliderMaximum}"
                                Value="{Binding PositionMs}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LengthText}" Foreground="#FFF2EFE9"
                                   FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="52" TextAlignment="Right"/>
                    </DockPanel>

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostIconButton}" Command="{Binding TogglePlayPauseCommand}"
                                    ToolTip="Play/Pause (Space)" AutomationProperties.Name="PlayPause" Width="40" Height="34">
                                <TextBlock FontFamily="{StaticResource FontIcons}" FontSize="17" Foreground="#FFF2EFE9">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <Button Style="{StaticResource GhostIconButton}" Command="{Binding SkipBackwardCommand}"
                                    Content="{Binding SkipBackwardSeconds, StringFormat=-{0}s}" FontSize="11.5"
                                    ToolTip="Skip backward (Left)"/>
                            <Button Style="{StaticResource GhostIconButton}" Command="{Binding SkipForwardCommand}"
                                    Content="{Binding SkipForwardSeconds, StringFormat=+{0}s}" FontSize="11.5"
                                    ToolTip="Skip forward (Right)"/>

                            <Button Style="{StaticResource GhostIconButton}" Click="VolumeButton_Click"
                                    ToolTip="Mute/Unmute (M)">
                                <TextBlock FontFamily="{StaticResource FontIcons}" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- Text must be a style setter (not an inline attribute):
                                                 local values outrank style triggers. -->
                                            <Setter Property="Foreground" Value="#FFF2EFE9"/>
                                            <Setter Property="Text" Value="&#xE767;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                    <Setter Property="Text" Value="&#xE74F;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Slider Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="125"
                                    Value="{Binding Volume}" VerticalAlignment="Center" Margin="-4,0,8,0"/>

                            <Button Style="{StaticResource GhostIconButton}" Click="RateButton_Click"
                                    Content="{Binding Rate, StringFormat={}{0:0.##}x}" FontSize="11.5" ToolTip="Playback speed"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack}"
                                      Visibility="{Binding HasSubtitles, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Subtitle track" MinWidth="120"/>
                            <Button Style="{StaticResource GhostIconButton}" Click="LoadSubtitle_Click"
                                    ToolTip="Load a subtitle file (.srt …)" Content="CC" FontSize="12" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}"
                                      Visibility="{Binding HasMultipleAudio, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Audio track" MinWidth="130" Margin="6,0,0,0"/>
                            <Button Style="{StaticResource GhostIconButton}" Click="Fullscreen_Click"
                                    ToolTip="Fullscreen (F)">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE740;" FontSize="15"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </vlc:VideoView>
</Window>
