<Window x:Class="NightOwls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NightOwls.Converters"
        Title="Night Owls" Width="1280" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgBase}"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        FontFamily="{StaticResource FontMain}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:EqualityToBoolConverter x:Key="NavEquals"/>
    </Window.Resources>

    <Border BorderBrush="#FF20202A" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF0C0C11">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE708;"
                                       FontSize="26" Foreground="{StaticResource BrushGold}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="NIGHT OWLS" FontSize="19" FontWeight="Light"
                                       Foreground="{StaticResource BrushGoldBright}" Margin="10,2,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="1.06"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="OFFLINE CINEMA FOR YOUR LOCAL FILES"
                                   FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" Margin="2,8,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
                        <Separator Background="{StaticResource BrushBorder}" Height="1" Margin="0,4,0,10"/>
                        <RadioButton GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ActiveNavTag, Mode=OneWay, Converter={StaticResource NavEquals}, ConverterParameter=SETTINGS}"
                                     Command="{Binding NavigateCommand}" CommandParameter="SETTINGS">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE713;" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource OutlineButton}" Margin="2,10,2,0"
                                Command="{Binding ScanLibraryCommand}" ToolTip="Scan all configured locations">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan Library" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="0,6,0,0">
                        <RadioButton GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ActiveNavTag, Mode=OneWay, Converter={StaticResource NavEquals}, ConverterParameter=HOME}"
                                     Command="{Binding NavigateCommand}" CommandParameter="HOME">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE80F;" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ActiveNavTag, Mode=OneWay, Converter={StaticResource NavEquals}, ConverterParameter=MOVIES}"
                                     Command="{Binding NavigateCommand}" CommandParameter="MOVIES">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE8B7;" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Movies" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ActiveNavTag, Mode=OneWay, Converter={StaticResource NavEquals}, ConverterParameter=FAVORITES}"
                                     Command="{Binding NavigateCommand}" CommandParameter="FAVORITES">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE734;" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Favorites" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding ActiveNavTag, Mode=OneWay, Converter={StaticResource NavEquals}, ConverterParameter=RECENT}"
                                     Command="{Binding NavigateCommand}" CommandParameter="RECENT">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE81C;" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Recently Watched" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF0E0E13" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostIconButton}" Click="Minimize_Click" ToolTip="Minimize">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE921;" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource GhostIconButton}" Click="Maximize_Click" ToolTip="Maximize / Restore">
                                <TextBlock x:Name="maxGlyph" FontFamily="{StaticResource FontIcons}" Text="&#xE922;" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource GhostIconButton}" Click="Close_Click" ToolTip="Close">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE8BB;" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStatusText}"
                                   FontSize="12" Foreground="{StaticResource BrushGoldBright}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

                        <Ellipse DockPanel.Dock="Right" Width="9" Height="9" Fill="{StaticResource BrushGold}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.5" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <TextBlock Text="{Binding CurrentPage.Title, TargetNullValue=''}"
                                   FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="24,0,12,0"/>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>

                <Border Grid.Row="2" Background="#FF0C0C11" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="18,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" TextAlignment="Right" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Text="Completely offline · No cloud · No accounts"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                            <Run Text="{Binding LibraryCount, Mode=OneWay}"/> movies in your local library
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
