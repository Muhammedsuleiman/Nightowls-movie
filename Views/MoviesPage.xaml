<UserControl x:Class="NightOwls.Views.MoviesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             FontFamily="{StaticResource FontMain}">
    <Grid Margin="28,10,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Padding="18,14" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,4,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Movie Library" FontSize="21" FontWeight="Light"
                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CountText}" FontSize="12.5" Foreground="{StaticResource BrushGold}"
                           VerticalAlignment="Center" Margin="14,2,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Sort" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox MinWidth="168" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Border Width="300" Background="#FF101015" CornerRadius="7"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource FontIcons}" Text="&#xE721;"
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Margin="1"
                                 BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ComboBox MinWidth="140" Margin="12,0,0,0" ItemsSource="{Binding AvailableFormats}"
                          SelectedItem="{Binding FormatFilter}" ToolTip="Filter by file format"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Movies}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="210,170" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding TitleDisplay}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Padding="40,30" Visibility="{Binding HasMovies, Converter={StaticResource BoolToVisCInverted}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE708;" FontFamily="{StaticResource FontIcons}" FontSize="52"
                               Foreground="#55D9A441" HorizontalAlignment="Center"/>
                    <TextBlock Text="No movies in your library yet" FontSize="19" FontWeight="Light"
                               Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="Add a library location in Settings and run Scan Library."
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
