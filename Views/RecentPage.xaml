<UserControl x:Class="NightOwls.Views.RecentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <Grid Margin="28,10,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Padding="18,14" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,4,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE81C;" FontSize="17"
                           Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                <TextBlock Text="Recently Watched" FontSize="21" FontWeight="Light"
                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Recent}" Margin="2,0,2,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="rowBg" Background="{StaticResource BrushCard}" CornerRadius="10"
                                    Padding="14" Margin="0,5" Cursor="Hand">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}"
                                            VerticalAlignment="Center" Padding="14,7"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE768;"
                                                       VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Watch again"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResumeCandidate}" Value="True">
                                                                <Setter Property="Text" Value="Continue"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <Border Width="120" Height="68" CornerRadius="7" ClipToBounds="True" Margin="0,0,14,0">
                                        <Grid>
                                            <Rectangle Fill="#FF101016"/>
                                            <Image Source="{Binding ThumbnailFile, Converter={StaticResource ThumbnailImage}}"
                                                   Stretch="UniformToFill"/>
                                            <Border Background="#E614141A" CornerRadius="4" Padding="5,1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                                    Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisC}}">
                                                <TextBlock Text="{Binding DurationMs, Converter={StaticResource DurationToClock}}"
                                                           FontSize="10.5" Foreground="#FFF2EFE9"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TitleDisplay}" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding LastWatched, Converter={StaticResource RelativeTime}}"
                                                       FontSize="11.5" Foreground="{StaticResource BrushGold}"/>
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResumeCandidate}" Value="True">
                                                                <Setter Property="Text" Value="{Binding ResumePositionMs, Converter={StaticResource DurationToClock}, ConverterParameter=0, StringFormat=Stopped at {0}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <ProgressBar Height="3" Minimum="0" Maximum="100" Margin="0,9,30,0"
                                                     Value="{Binding ResumeFraction, Converter={StaticResource FractionToPercent}, Mode=OneWay}"
                                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Border Background="#33FFFFFF" CornerRadius="1.5">
                                                        <Border x:Name="PART_Indicator" Background="{StaticResource BrushGoldBright}"
                                                                CornerRadius="1.5" HorizontalAlignment="Left"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="rowBg" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="rowBg" Property="Background" Value="{StaticResource BrushCardHover}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Padding="40,30" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisCInverted}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource FontIcons}" FontSize="48"
                               Foreground="#55D9A441" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nothing watched yet" FontSize="19" FontWeight="Light"
                               Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="Movies you play will show up here with their playback position."
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
