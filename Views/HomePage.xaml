<UserControl x:Class="NightOwls.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,24">

            <Border CornerRadius="14" Padding="30,26" Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,4,0,22">
                <StackPanel>
                    <TextBlock Text="G O O D   E V E N I N G ,   N I G H T   O W L" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushGold}"/>
                    <TextBlock Text="Your Night Awaits" FontSize="30" FontWeight="Light"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding LibrarySummary}" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,7,0,0"
                               Visibility="{Binding HasMovies, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource GoldButton}"
                                Command="{Binding DataContext.ScanLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan Library" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Margin="12,0,0,0"
                                Command="{Binding GoToMoviesCommand}">
                            <TextBlock Text="Browse Movies"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasMovies, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Continue Watching" Style="{StaticResource SectionHeader}" Margin="2,2,0,10"
                           Visibility="{Binding HasContinueWatching, Converter={StaticResource BoolToVis}}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasContinueWatching, Converter={StaticResource BoolToVis}}" Margin="0,0,0,18">
                    <ItemsControl ItemsSource="{Binding ContinueWatching}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Recently Watched" Style="{StaticResource SectionHeader}" Margin="2,2,0,10"
                           Visibility="{Binding HasRecentlyWatched, Converter={StaticResource BoolToVis}}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasRecentlyWatched, Converter={StaticResource BoolToVis}}" Margin="0,0,0,18">
                    <ItemsControl ItemsSource="{Binding RecentlyWatched}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Favorites" Style="{StaticResource SectionHeader}" Margin="2,2,0,10"
                           Visibility="{Binding HasFavoriteRow, Converter={StaticResource BoolToVis}}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasFavoriteRow, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding FavoriteRow}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <Border CornerRadius="14" Padding="40,34"
                    Visibility="{Binding HasMovies, Converter={StaticResource BoolToVisCInverted}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE708;" FontFamily="{StaticResource FontIcons}" FontSize="52"
                               Foreground="#55D9A441" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your library is empty" FontSize="20" FontWeight="Light"
                               Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="No movies found yet. Choose a folder or drive and scan your library."
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
