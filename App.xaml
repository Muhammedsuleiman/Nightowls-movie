<Application x:Class="NightOwls.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NightOwls.ViewModels"
             xmlns:views="clr-namespace:NightOwls.Views"
             xmlns:conv="clr-namespace:NightOwls.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MoviesViewModel}">
                <views:MoviesPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
                <views:FavoritesPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecentViewModel}">
                <views:RecentPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage/>
            </DataTemplate>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BytesToHumanConverter x:Key="BytesToHuman"/>
            <conv:DurationToClockConverter x:Key="DurationToClock"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisInverted" Invert="True"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisC"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisCInverted" Invert="True"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisEmptyOnly"/>
            <conv:FractionToPercentConverter x:Key="FractionToPercent"/>
            <conv:RelativeTimeConverter x:Key="RelativeTime"/>
            <conv:ThumbnailImageConverter x:Key="ThumbnailImage"/>

            <DataTemplate DataType="{x:Type vm:MovieCardViewModel}">
                <Border x:Name="cardRoot" CornerRadius="10" Background="Transparent"
                        Margin="7,7,7,13" Cursor="Hand" SnapsToDevicePixels="True"
                        AutomationProperties.Name="{Binding TitleDisplay}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick"
                                      Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}"/>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" CornerRadius="9" Background="{StaticResource BrushSurface}">
                            <Grid Width="196" Height="110">
                                <Border CornerRadius="9" ClipToBounds="True">
                                    <Grid>
                                        <Rectangle Fill="#FF101016"/>
                                        <Image Source="{Binding ThumbnailFile, Converter={StaticResource ThumbnailImage}, Mode=OneWay}"
                                               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE708;"
                                                   Foreground="#3DD9A441" FontSize="34"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding ThumbnailFile, Converter={StaticResource NullToVisInverted}}"/>
                                        <Border Background="#B3000000" CornerRadius="9"
                                                Visibility="{Binding Unavailable, Converter={StaticResource BoolToVisC}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource FontIcons}" Text="&#xE9F5;"
                                                           Foreground="{StaticResource BrushDanger}" FontSize="22"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Drive offline" FontSize="11"
                                                           Foreground="{StaticResource BrushDanger}"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}"/>

                                <Border Background="#E614141A" CornerRadius="5" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                    <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource BrushGold}"/>
                                </Border>

                                <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                        ToolTip="Toggle favorite">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="favBg" Background="#CC14141A" CornerRadius="6"
                                                    Width="30" Height="26">
                                                <TextBlock x:Name="favGlyph" FontFamily="{StaticResource FontIcons}"
                                                           Text="&#xE735;" FontSize="14" FontWeight="Normal"
                                                           Foreground="#66FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="favGlyph" Property="Foreground" Value="#FFFFFFFF"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter TargetName="favGlyph" Property="Foreground" Value="{StaticResource BrushGoldBright}"/>
                                                    <Setter TargetName="favGlyph" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Border Background="#E614141A" CornerRadius="5" Padding="6,2"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7"
                                        Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisC}}">
                                    <TextBlock Text="{Binding DurationMs, Converter={StaticResource DurationToClock}}"
                                               FontSize="11" Foreground="#FFF2EFE9"/>
                                </Border>

                                <ProgressBar Height="3" Minimum="0" Maximum="100"
                                             Value="{Binding ResumeFraction, Converter={StaticResource FractionToPercent}, Mode=OneWay}"
                                             VerticalAlignment="Bottom" Margin="8,8"
                                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisC}}">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border Background="#55FFFFFF" CornerRadius="1.5">
                                                <Border x:Name="PART_Track" CornerRadius="1.5">
                                                    <Border x:Name="PART_Indicator" Background="{StaticResource BrushGoldBright}"
                                                            CornerRadius="1.5" HorizontalAlignment="Left"/>
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="2,9,2,0">
                            <TextBlock Text="{Binding TitleDisplay}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding FileSizeBytes, Converter={StaticResource BytesToHuman}}"
                                           FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding FolderName}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="cardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="cardRoot" Property="Background" Value="{StaticResource BrushCardHover}"/>
                        <Setter TargetName="cardRoot" Property="Effect" Value="{StaticResource CardShadow}"/>
                        <Setter TargetName="cardRoot" Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="-2"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
